{
  "name": "sonarqube-ce-action",
  "description": "SonarQube CE Scan, Analysis, and Reports",
  "version": "0.1.0",
  "author": "mmb L",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "format:write": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "package": "rm -rf ./dist && rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "package:watch": "npm run package -- --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "all": "biome ci . && npm run test:coverage && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@github/local-action": "^7.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "rollup": "^4.62.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^3.1.1"
  }
}
